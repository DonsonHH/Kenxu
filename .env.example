# Development defaults. Production requires an explicit HTTPS PUBLIC_ORIGIN.
NODE_ENV=development
DATA_DIR=./data
PUBLIC_ORIGIN=http://127.0.0.1:4450
ADMIN_ORIGIN=http://127.0.0.1:4451
PORT=4450
ADMIN_PORT=4451
## Optional private offline Country/City MMDB; never commit the database.
# GEOIP_DB=/absolute/private/path/geoip-country.mmdb
# Optional server-only IPinfo Lite token. Never put it in public files or Git.
# IPINFO_TOKEN=REPLACE_WITH_PRIVATE_TOKEN
